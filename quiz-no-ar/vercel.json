{
  "redirects": [
    {
      "source": "/",
      "destination": "/quizprosperidade/",
      "permanent": false
    }
  ],
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/es/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/es/(lectura|mi-codigo|admin)/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}